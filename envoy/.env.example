# Copy to `.env` IN THIS DIRECTORY:  cp .env.example .env
# compose reads it automatically when you run `up -d` from here. `.env` is
# gitignored; THIS file is tracked and must never carry a real value.
#
# THIS FILE BELONGS TO THE ENVOY GATEWAY ALONE. Each gateway is a standalone
# compose project with its own .env, so ../litellm has its own and can name a
# DIFFERENT engine. Nothing checks that the two agree.
#
# THERE IS NO KEY VARIABLE FOR THE GATEWAY ITSELF. `aigw run` authenticates no
# caller at all: anything that can reach 26000 can call it. The keys below are
# what the gateway sends UPSTREAM, and a caller never sees them.

# --- WHICH ENGINE ---------------------------------------------------------------
# ONE WORD, and it is the only thing that decides what this gateway serves. Five
# engines exist, one self-contained file each in config/:
#
#   lms          LMStudio, on this machine        free    lms-4b lms-26b lms-embed
#   unsloth      Unsloth Studio, on this machine  free    unsloth-4b -26b -embed
#   ollama       Ollama, on this machine          free    ollama-4b -26b -embed
#   openrouter   OpenRouter                       PAID    openrouter-26b
#   openai       OpenAI                           PAID    openai-mini openai-embed
#
# `openrouter-free` IS DELIBERATELY ABSENT HERE, and it is the one alias this
# gateway does not carry. That route needs a provider pin sent as a vendor-specific
# object in the request body, and this gateway has no equivalent of LiteLLM's
# `extra_body`. An unpinned copy would return tool calls as raw text — an agent
# that executes nothing and reports no error.
#
# ONE ENGINE AT A TIME. Every other engine's aliases have no route rule at all, so
# a 404 on one is correct.
#
# SELECTING A PAID ENGINE IS THE ONLY WAY ANYTHING HERE CAN SPEND MONEY. There are
# no fallbacks anywhere in this config, so a request costs money only when a caller
# names a route that costs money.
#
# A TYPO IS A CLEAN CRASH: config/<word>.yaml does not exist and aigw exits saying
# so. `podman compose logs envoy` names the file.
GATEWAY_ENGINE=lms

# --- THERE IS NO GATEWAY_DISCOVERY HERE -----------------------------------------
# ../litellm can generate its alias list from whatever the engine holds on disk.
# This one cannot yet: its config is Kubernetes custom resources, which needs
# another renderer, and the aigw image is distroless so it has no Python to run one
# in. README.md § Auto-discovery has the detail.

# --- Per-request logging --------------------------------------------------------
# `false` by default, and it must never be EMPTY: aigw parses this as a bool flag
# and crash-loops on an empty string before it reads any config.
#
# WITH IT FALSE YOU SEE NOTHING PER-REQUEST. Envoy runs as a child of aigw and its
# stdout — where the JSON access log goes — lands in a file inside the container
# that no shell can reach, because the image is distroless. `compose logs envoy`
# then shows only the startup lines, however much traffic you send.
#
# SET IT TO `true` AND YOU GET BOTH: one JSON access line per request (model, token
# counts, status, duration) AND aigw's own debug dump, which carries the FULL
# PROMPT AND RESPONSE with only the Authorization header redacted. That is this
# gateway's equivalent of LiteLLM's Logs tab, and it is also why it is off here.
AIGW_DEBUG=false

# --- Upstream keys --------------------------------------------------------------
# aigw substitutes ${VAR} into the Secret in config/<engine>.yaml before parsing
# it, so a key reaches the gateway without ever being written to a file here.
#
# LEAVE THESE BLANK. They are personal credentials and already reach every shell
# under ~/Projects from ~/.secrets/secrets.enc.yaml through ~/Projects/.envrc.
# Compose reads the SHELL environment before this file, so a blank line resolves
# to the real value at `up` time and no second plaintext copy is created.
#
# A BLANK VALUE SUBSTITUTES EMPTY and the route then fails at CALL time with the
# provider's own 401 — the same failure shape as ../litellm.
#
# THERE IS NO KEY FOR LMSTUDIO OR OLLAMA. LMStudio takes any string and Ollama
# ignores the header entirely, so both configs carry a literal.
UNSLOTH_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
