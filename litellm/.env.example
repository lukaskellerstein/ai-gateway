# Copy to `.env` IN THIS DIRECTORY:  cp .env.example .env
# compose reads it automatically when you run `up -d` from here. `.env` is
# gitignored; THIS file is tracked and must never carry a real value.
#
# THIS FILE BELONGS TO THE LITELLM GATEWAY ALONE. Each gateway is a standalone
# compose project with its own .env, so ../envoy has its own and can name a
# DIFFERENT engine. Nothing checks that the two agree.
#
# THERE IS NO COMPOSE_PROFILES LINE ANY MORE. Before the split one word chose
# which gateway ran; now the directory you are standing in is that choice, and
# `up -d` here starts this gateway whether or not this file exists.

# --- WHICH ENGINE ---------------------------------------------------------------
# ONE WORD, and it is the only thing that decides what this gateway serves. Six
# values: five engines with one config file each in config/, and `all`.
#
#   all          EVERY ENGINE BELOW               13 aliases      THE DEFAULT
#   lms          LMStudio, on this machine        free    lms-4b lms-26b lms-embed
#   unsloth      Unsloth Studio, on this machine  free    unsloth-4b -26b -embed
#   ollama       Ollama, on this machine          free    ollama-4b -26b -embed
#   openrouter   OpenRouter                       PAID    openrouter-26b -free
#   openai       OpenAI                           PAID    openai-mini openai-embed
#
# `all` IS THE DEFAULT because one gateway serving everything is what you want most
# days: `up -d` here and every alias answers on 24000. config/all.yaml is six
# `include:` lines and copies nothing, so the per-engine files stay the one place an
# alias is written.
#
# THE OTHER FIVE WORDS ARE FOR ISOLATION, and that is still worth having. Name one
# engine and the gateway serves its two or three aliases and NOTHING ELSE — every
# other alias is absent from the running config, not disabled, and a 404 on one is
# correct. `GATEWAY_ENGINE=lms` is how you get a gateway that cannot reach a paid
# provider even if a caller asks for one by name.
#
# AN ENGINE IS AN ENGINE, LOCAL OR HOSTED. There is no separate cloud switch,
# because the alias names already say which is which: `lms-*` and `ollama-*` are
# this machine, `openrouter-*` and `openai-*` are not. One property, one word.
#
# SPENDING MONEY TAKES A CALLER NAMING A PAID ALIAS. With `all` the two hosted
# engines are REGISTERED, and that costs nothing — only a completion bills. Nothing
# falls back to anything, so no free alias can quietly become a paid one. LiteLLM is
# a stock image and prints no warning, so the alias PREFIX is the warning on 24000.
#
# A TYPO IS A CLEAN CRASH: config/<word>.yaml does not exist and litellm exits
# saying so.
GATEWAY_ENGINE=all

# --- THERE IS NO GATEWAY_DISCOVERY ANY MORE -------------------------------------
# Until 2026-09-06 a `discover` one-shot could ask a local engine what it held on
# disk and generate config/discovered-<engine>.yaml, adding every model it found.
# The service, the module and the variable are all gone, and with them the only
# Python in this repo and the trap where `GATEWAY_DISCOVERY=off` turned it ON.
#
# EVERY ALIAS IS NOW HAND-WRITTEN, in config/<engine>.yaml. That is the whole
# vocabulary of this gateway. A stale GATEWAY_DISCOVERY line in your own .env is
# inert — compose no longer reads it — but delete it anyway.

# --- Gateway ------------------------------------------------------------------
# The ADMINISTRATIVE credential: it mints virtual keys and has no spending ceiling
# of its own. Callers get a budgeted virtual key from `/key/generate`, never this
# one. Change it for anything beyond a laptop.
LITELLM_MASTER_KEY=sk-litellm-master

# --- The three LOCAL engines --------------------------------------------------
# All three run NATIVELY on the host for the Apple-Silicon GPU, and all three bind
# 127.0.0.1 only. The container still reaches them at host.containers.internal
# (Podman) / host.docker.internal (Docker), so these lines rarely change.
LM_STUDIO_API_BASE=http://host.containers.internal:1234/v1
UNSLOTH_API_BASE=http://host.containers.internal:8888/v1
OLLAMA_API_BASE=http://host.containers.internal:11434/v1

# UNLIKE LMStudio, Unsloth REQUIRES a key: every route answers `401 Not
# authenticated` without one, `/v1/models` included. Make one in the app —
# avatar (bottom-left) -> Settings -> API -> Create — and note that it is shown
# only ONCE and is stored hashed, so a lost key is remade, never recovered.
#
# LEAVE THIS BLANK, for the same reason as the two provider keys below: it is a
# personal credential. Put it in ~/.secrets/secrets.enc.yaml with `secret-edit`
# and let ~/Projects/.envrc export it. A blank value here does not disable the
# `unsloth-*` aliases — they stay in the config and answer 401 at call time.
UNSLOTH_API_KEY=

# THERE IS NO OLLAMA_API_KEY, and nothing is missing: Ollama does not read the
# Authorization header at all. config/ollama.yaml still sets a literal `sk-ollama`
# on every route, because LiteLLM's `openai/` provider needs some key string.

# --- Hosted providers ---------------------------------------------------------
# The keys the two PAID engines bill. `openrouter-*` needs OPENROUTER_API_KEY and
# `openai-*` needs OPENAI_API_KEY; neither engine is in the config at all unless
# GATEWAY_ENGINE names it. A missing key keeps the alias and answers 401 at call
# time.
#
# LEAVE THESE BLANK. They are personal credentials, not per-project config, and
# they already reach every shell under ~/Projects from ~/.secrets/secrets.enc.yaml
# through ~/Projects/.envrc. Compose interpolates `${OPENROUTER_API_KEY:-}` from the
# SHELL environment first and only falls back to this file, so a blank line here
# resolves to the real value at `up` time and no second plaintext copy is created.
#
# Writing them in anyway is not a shortcut, it is a copy that `secret-edit`
# rotation will not reach — the old value keeps working here long after it was
# rotated everywhere else.
#
# Only fill these in on a machine with no ~/Projects/.envrc (a CI runner, a
# colleague's laptop).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
