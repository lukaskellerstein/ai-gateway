# Copy to `.env` (same directory) and fill in:  cp .env.example .env
# compose reads that file automatically. `.env` is gitignored; THIS file is tracked and
# must never carry a real value.

# --- WHICH GATEWAY RUNS ---------------------------------------------------------
# `litellm`, `mlflow`, both (comma-separated), or the shorthand `all`.
#
#   litellm   the primary endpoint on 24000. Virtual keys, spend logs, budget
#             ceilings and /v1/messages — everything a project actually needs.
#   mlflow    the second gateway on 25000: the SAME alias names, no key at all, and
#             a trace per request. Nothing in mlflow/ reads anything in litellm/, so
#             this runs perfectly well on its own.
#
# THIS LINE IS NOT OPTIONAL. COMPOSE_PROFILES is compose's OWN variable, and a
# service that carries a profile does not start until its profile is named — so
# with this line missing, `up -d` brings up postgres and NOTHING ELSE. That is why
# the quick start begins with `cp .env.example .env`.
#
# For one command instead of a permanent choice: `docker compose --profile mlflow up -d`.
COMPOSE_PROFILES=litellm,mlflow

# --- WHICH ENGINE ---------------------------------------------------------------
# ONE WORD, and it is the only thing that decides what the gateway serves. Five
# engines exist, one self-contained config file each:
#
#   lms          LMStudio, on this machine        free    lms-4b lms-26b lms-embed
#   unsloth      Unsloth Studio, on this machine  free    unsloth-4b -26b -embed
#   ollama       Ollama, on this machine          free    ollama-4b -26b -embed
#   openrouter   OpenRouter                       PAID    openrouter-26b -free
#   openai       OpenAI                           PAID    openai-mini openai-embed
#
# ONE ENGINE AT A TIME. There is no list and no `all`. The gateway serves that
# engine's two or three aliases and nothing else, on BOTH ports.
#
# AN ENGINE IS AN ENGINE, LOCAL OR HOSTED. There is no separate cloud switch,
# because the alias names already say which is which: `lms-*` and `ollama-*` are
# this machine, `openrouter-*` and `openai-*` are not. One property, one word.
#
# SELECTING A PAID ENGINE IS THE ONLY WAY ANYTHING HERE CAN SPEND MONEY. With a
# local engine selected, the running gateway has no hosted route at all — not a
# disabled one, an absent one. Nothing falls back either: an alias names one route.
# `mlflow-seed` prints a PAID ENGINE line in its log when you pick one; LiteLLM is a
# stock image and prints nothing, so the alias prefix is the warning on 24000.
#
# TO COMPARE TWO ENGINES, change this word and run `docker compose up -d` again.
# The aliases are named so only the prefix differs — `lms-26b`, `unsloth-26b`,
# `ollama-26b` and `openrouter-26b` are the same weights, so `cd tests && uv run
# run_all.py` twice with a different word measures the engine and nothing else.
#
# A TYPO STOPS BOTH GATEWAYS, and only one of them explains itself: `mlflow-seed`
# exits 2 naming the bad word and listing the five valid ones, while `litellm`
# crash-loops on a config file that does not exist. Read the seed's log first.
GATEWAY_ENGINE=lms

# --- Gateway ------------------------------------------------------------------
# The ADMINISTRATIVE credential: it mints virtual keys and has no spending ceiling of
# its own. Callers get a budgeted virtual key from `/key/generate`, never this one.
# Change it for anything beyond a laptop.
LITELLM_MASTER_KEY=sk-litellm-master

# How containers reach LMStudio running natively on the host.
# Podman:  http://host.containers.internal:1234/v1   (default below)
# Docker:  http://host.docker.internal:1234/v1
LM_STUDIO_API_BASE=http://host.containers.internal:1234/v1

# --- Unsloth Studio -----------------------------------------------------------
# The second local runtime, on port 8888, serving the `unsloth-*` aliases. It
# binds 127.0.0.1 exactly as LMStudio does and the containers reach it the same
# way, so this line rarely changes.
UNSLOTH_API_BASE=http://host.containers.internal:8888/v1

# UNLIKE LMStudio, Unsloth REQUIRES a key: every route answers `401 Not
# authenticated` without one, `/v1/models` included. Make one in the app —
# avatar (bottom-left) -> Settings -> API -> Create — and note that it is shown
# only ONCE and is stored hashed, so a lost key is remade, never recovered.
#
# LEAVE THIS BLANK, for the same reason as the three provider keys below: it is a
# personal credential. Put it in ~/.secrets/secrets.enc.yaml with `secret-edit`
# and let ~/Projects/.envrc export it.
#
# A BLANK VALUE HERE FAILS QUIETLY AND DIFFERENTLY ON EACH GATEWAY. LiteLLM keeps
# the `unsloth-*` aliases and returns 401 at call time; the MLflow seed skips them
# with "no API key in the environment" and MLflow never gets the endpoints at
# all, so the same name 404s on 25000 and 401s on 24000.
UNSLOTH_API_KEY=

# --- Ollama -------------------------------------------------------------------
# The third local runtime, on port 11434, serving the `ollama-*` aliases. It binds
# 127.0.0.1 exactly as the other two do and the containers reach it the same way,
# so this line rarely changes.
#
# THERE IS NO OLLAMA_API_KEY, and nothing is missing. Ollama does not read the
# Authorization header at all. Both gateways still set a literal `sk-ollama` on
# every `ollama-*` route: LiteLLM's `openai/` provider needs some key string, and
# the MLflow seed SKIPS any endpoint whose key is empty — a skipped endpoint is an
# alias that answers on 24000 and 404s on 25000.
OLLAMA_API_BASE=http://host.containers.internal:11434/v1

# --- MLflow gateway -----------------------------------------------------------
# Wraps the key that encrypts the provider credentials MLflow stores in its
# database. Blank is supported: MLflow falls back to a built-in passphrase and
# writes a warning at startup. Fill it in for anything beyond a laptop.
#
# CHANGING IT LATER BREAKS THE STORED SECRETS. They were encrypted under the old
# value and stop decrypting, which shows up at call time as an auth failure, not
# at startup. The repair is `podman compose up -d`, because mlflow-seed rewrites
# every secret on each run.
MLFLOW_CRYPTO_KEK_PASSPHRASE=

# --- Hosted providers ---------------------------------------------------------
# The keys the two PAID engines bill. `openrouter-*` needs OPENROUTER_API_KEY and
# `openai-*` needs OPENAI_API_KEY; neither engine is in the config at all unless
# GATEWAY_ENGINE names it.
#
# A MISSING KEY FAILS TWICE, DIFFERENTLY, and this is worth knowing before you
# diagnose it: LiteLLM keeps the alias and answers 401 at call time, while the MLflow
# seed skips the endpoint entirely. So the same name 401s on 24000 and 404s on 25000.
#
# HF_TOKEN IS NO LONGER USED BY ANYTHING. HuggingFace only ever backed `standard-hf`,
# a fallback target, and nothing has a fallback chain now. The line stays because
# compose still passes it through and a future engine may want it.
#
# LEAVE THESE THREE BLANK. They are personal credentials, not per-project config, and
# they already reach every shell under ~/Projects from ~/.secrets/secrets.enc.yaml via
# ~/Projects/.envrc. Compose interpolates `${OPENROUTER_API_KEY:-}` (compose.yml) from
# the SHELL environment first and only falls back to this file, so a blank line here
# resolves to the real value at `up` time and no second plaintext copy is created.
#
# Writing them in anyway is not a shortcut, it is a copy that `secret-edit` rotation
# will not reach — the old value keeps working here long after it was rotated
# everywhere else.
#
# Only fill these in on a machine that has no ~/Projects/.envrc (a CI runner, a
# colleague's laptop).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
