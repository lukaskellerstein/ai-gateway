# Live values. Only .env.example is tracked, and it must never carry a real value.
# No leading slash, so this matches at every depth: each gateway project keeps its
# OWN .env beside its compose.yml, and there is no repo-root one any more.
.env
.envrc

# Credentials of any kind, in case one is ever written here by hand.
*.key
*.pem
.agent-token

# Machine-local Claude Code overrides. settings.json IS tracked; this one never is
# — it is where a gateway key would land if one were ever put in an `env` block.
.claude/settings.local.json

# Auto-discovery's output. The `discover` service rewrites it on every `up -d` from
# whatever the engine holds on THIS machine, so it is a local fact and never a
# shared one. The hand-written config/<engine>.yaml files it includes ARE tracked.
litellm/config/discovered-*.yaml

# Each gateway's tests/ is its own uv project. The lockfile IS tracked; the
# environment it builds is not.
.venv/
__pycache__/

.DS_Store
